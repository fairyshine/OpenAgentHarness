---
import ProductLayout from "../components/ProductLayout.astro";
import { sitePath } from "../lib/site-paths";

const capabilities = [
  {
    label: "Workspace Control",
    title: "Treat every workspace as a durable runtime unit.",
    body: "OAH owns lifecycle, placement, state sync, and execution boundaries so UI surfaces do not need to re-implement agent orchestration.",
  },
  {
    label: "Runtime Spec",
    title: "Configure agents with files that can be reviewed.",
    body: "Settings, prompts, models, tools, hooks, and MCP servers live as versioned workspace configuration instead of hidden app state.",
  },
  {
    label: "Parallel Engine",
    title: "Scale from local loops to distributed workers.",
    body: "Embedded workers keep development simple; split deployments add queues, controllers, and storage for larger multi-workspace runs.",
  },
];

const surfaces = ["WebUI", "TUI", "Desktop", "REST API", "SSE Stream", "Worker"];

const metrics = [
  ["133", "generated site pages"],
  ["REST + SSE", "shared integration contract"],
  ["PostgreSQL", "durable source of truth"],
  ["Redis", "queue coordination"],
];

const operatingLoop = [
  "Load workspace",
  "Validate runtime",
  "Start run",
  "Stream events",
  "Persist state",
];
---

<ProductLayout
  title="Open Agent Harness"
  description="Open Agent Harness is an agent runtime platform for parallel workspace orchestration, durable execution, and product-grade AI engineering."
>
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-backdrop" aria-hidden="true">
      <div class="system-map">
        <div class="map-row map-row--top">
          {surfaces.slice(0, 3).map((surface) => <span>{surface}</span>)}
        </div>
        <div class="map-core">
          <img src={sitePath("/assets/logo-mkdocs-dark.png")} alt="" />
          <strong>OAH Engine</strong>
          <small>workspace lifecycle + agent loop + tool calls</small>
        </div>
        <div class="map-row">
          {surfaces.slice(3).map((surface) => <span>{surface}</span>)}
        </div>
      </div>
    </div>

    <div class="hero-copy">
      <p class="eyebrow">Agent runtime for serious product teams</p>
      <h1 id="hero-title">Open Agent Harness</h1>
      <p>
        A long-term maintainable execution layer for AI products: run many workspaces in parallel,
        keep agent configuration reviewable, and expose one consistent API to WebUI, TUI, and Desktop clients.
      </p>
      <div class="hero-actions">
        <a class="button button--primary" href={sitePath("/docs/")}>Explore docs</a>
        <a class="button button--secondary" href={sitePath("/architecture/")}>View architecture</a>
      </div>
      <div class="hero-meta" aria-label="Runtime qualities">
        <span>Workspace-native</span>
        <span>Queue-aware</span>
        <span>API-first</span>
      </div>
    </div>
  </section>

  <section class="proof" aria-label="Platform highlights">
    {metrics.map(([value, label]) => (
      <div>
        <strong>{value}</strong>
        <span>{label}</span>
      </div>
    ))}
  </section>

  <section class="section section--intro">
    <div>
      <p class="section-kicker">Why OAH exists</p>
      <h2>Move agent work out of the demo layer and into an operating system you can maintain.</h2>
    </div>
    <p>
      Mature AI products need more than a chat box. They need deterministic workspace loading, runtime
      validation, replayable events, queue-aware execution, and docs that explain the contract between
      clients, control plane, workers, and storage.
    </p>
  </section>

  <section class="capabilities" aria-label="Core capabilities">
    {capabilities.map((item) => (
      <article>
        <span>{item.label}</span>
        <h3>{item.title}</h3>
        <p>{item.body}</p>
      </article>
    ))}
  </section>

  <section class="operator-view" aria-labelledby="operator-title">
    <div class="operator-copy">
      <p class="section-kicker">Built for operation</p>
      <h2 id="operator-title">One engine, multiple surfaces, clear ownership.</h2>
      <p>
        Product teams can keep the user experience focused while OAH handles the runtime mechanics:
        controller decisions, worker execution, storage persistence, and streaming progress.
      </p>
      <a href={sitePath("/architecture/")}>Explore engine shape</a>
    </div>
    <div class="console" aria-label="Example runtime command output">
      <div class="console-bar"><span></span><span></span><span></span></div>
      <pre><code>$ pnpm dev:cli -- daemon start
workspace oah/demo loaded
runtime settings validated
controller queue online
worker pool ready
sse stream connected</code></pre>
    </div>
  </section>

  <section class="process-strip" aria-label="Runtime operating loop">
    {operatingLoop.map((item, index) => (
      <div>
        <span>{String(index + 1).padStart(2, "0")}</span>
        <strong>{item}</strong>
      </div>
    ))}
  </section>

  <section class="doc-routes" aria-labelledby="routes-title">
    <div>
      <p class="section-kicker">Site paths</p>
      <h2 id="routes-title">Four front doors before the full reference.</h2>
    </div>
    <div class="route-grid">
      <a href={sitePath("/docs/")}><strong>Docs</strong><span>Find the right guide, reference page, or operations checklist.</span></a>
      <a href={sitePath("/architecture/")}><strong>Architecture</strong><span>Understand the planes, boundaries, and ownership model.</span></a>
      <a href={sitePath("/api/")}><strong>API</strong><span>Enter from REST, SSE, OpenAPI, or resource-specific contracts.</span></a>
      <a href={sitePath("/roadmap/")}><strong>Roadmap</strong><span>Track maturity, production readiness, and next implementation steps.</span></a>
    </div>
  </section>
</ProductLayout>
