---
import ProductLayout from "../components/ProductLayout.astro";
import { sitePath } from "../lib/site-paths";

const docGroups = [
  {
    label: "01",
    title: "Start and orient",
    body: "Run OAH locally, learn the product boundary, and understand the vocabulary used across the docs.",
    href: "/getting-started/",
  },
  {
    label: "02",
    title: "Configure a workspace",
    body: "Review runtime templates, settings, prompts, agents, models, skills, hooks, MCP servers, and validation rules.",
    href: "/workspace/",
  },
  {
    label: "03",
    title: "Trace the engine",
    body: "Follow lifecycle, context construction, message projection, queue reliability, and worker ownership.",
    href: "/engine/",
  },
  {
    label: "04",
    title: "Integrate through the API",
    body: "Browse OpenAPI resources, streaming events, schemas, actions, storage, and model contracts.",
    href: "/openapi/",
  },
  {
    label: "05",
    title: "Operate deployments",
    body: "Move from embedded worker development to split deployment, Kubernetes rollout, readiness checks, and runbooks.",
    href: "/operations/",
  },
  {
    label: "06",
    title: "Plan the roadmap",
    body: "Track product maturity, implementation stages, worker scale, and the next maintenance decisions.",
    href: "/roadmap/",
  },
];

const collections = [
  ["Orientation", "/docs/overview/", "A curated map of the migrated Starlight documentation."],
  ["Workspace spec", "/workspace/", "Settings, prompts, agents, models, actions, skills, hooks, and MCP."],
  ["Engine internals", "/engine/", "Lifecycle, context, projections, workers, queues, and events."],
  ["Operations shelf", "/operations/", "Deployment, server config, production readiness, and Kubernetes runbooks."],
];

const docSignals = [
  ["Task-first", "Product pages route readers by job before the full sidebar appears."],
  ["Reference-safe", "Existing Starlight URLs stay stable for deep links and edit links."],
  ["Maintainable", "Sidebar sections now reflect ownership boundaries, not historical file order."],
];
---

<ProductLayout
  active="docs"
  title="Docs | Open Agent Harness"
  description="A guided entry point for Open Agent Harness documentation, runtime configuration, API references, and operations guides."
>
  <section class="page-hero page-hero--compact">
    <div>
      <p class="eyebrow">Documentation hub</p>
      <h1>Choose a lane before opening the reference.</h1>
      <p>
        The Starlight reference stays deep and searchable. This hub groups the docs by reader intent:
        get oriented, configure a workspace, understand the engine, integrate the API, operate a deployment,
        or plan the next implementation step.
      </p>
      <div class="hero-actions">
        <a class="button button--primary" href={sitePath("/getting-started/")}>Start with the guide</a>
        <a class="button button--secondary" href={sitePath("/operations/")}>Open operations</a>
      </div>
    </div>
    <div class="hero-side-panel" aria-label="Documentation signals">
      {docSignals.map(([title, body]) => (
        <div>
          <strong>{title}</strong>
          <span>{body}</span>
        </div>
      ))}
    </div>
  </section>

  <section class="page-grid page-grid--six" aria-label="Documentation groups">
    {docGroups.map((item) => (
        <a class="link-card" href={sitePath(item.href)}>
        <span>{item.label}</span>
        <strong>{item.title}</strong>
        <p>{item.body}</p>
      </a>
    ))}
  </section>

  <section class="split-panel" aria-labelledby="docs-map-title">
    <div>
      <p class="section-kicker">Maintenance map</p>
      <h2 id="docs-map-title">Keep each page close to its owner.</h2>
      <p>
        The product pages are intentionally shallow. Durable technical detail still belongs in Starlight,
        but the sidebar now mirrors ownership: workspace configuration, engine internals, API contract,
        operations, and roadmap each have their own shelf.
      </p>
    </div>
    <div class="resource-list">
      {collections.map(([title, href, body]) => (
        <a href={sitePath(href)}>
          <strong>{title}</strong>
          <span>{body}</span>
        </a>
      ))}
    </div>
  </section>
</ProductLayout>
