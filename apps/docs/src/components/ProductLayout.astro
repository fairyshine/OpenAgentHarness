---
import "../styles/product.css";

interface Props {
  active?: "docs" | "architecture" | "api" | "roadmap";
  description: string;
  title: string;
}

const { active, description, title } = Astro.props;

const navItems = [
  { key: "docs", label: "Docs", href: "/docs/" },
  { key: "architecture", label: "Architecture", href: "/architecture/" },
  { key: "api", label: "API", href: "/api/" },
  { key: "roadmap", label: "Roadmap", href: "/roadmap/" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/assets/logo-mkdocs.png" />
  </head>
  <body>
    <div class="product-shell">
      <header class="product-nav" aria-label="Primary navigation">
        <a class="brand" href="/" aria-label="Open Agent Harness home">
          <img src="/assets/logo-mkdocs-dark.png" alt="" />
          <span>Open Agent Harness</span>
        </a>
        <nav>
          {
            navItems.map((item) => (
              <a class:list={[{ "is-active": active === item.key }, "nav-link"]} href={item.href}>
                {item.label}
              </a>
            ))
          }
        </nav>
        <a class="nav-cta" href="/getting-started/">Start</a>
      </header>

      <main>
        <slot />
      </main>
    </div>
  </body>
</html>
